# Solo para desarrollo local. Nunca reutilices estos valores en producción.
APP_ENV=development
AUTH_MODE=mock
ENABLE_TEST_AUTH=true
DEV_TEST_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=change-this-db-password
CORS_ORIGINS=
SITE_ADDRESS=ova-prueba.example.com
PILOT_USER=piloto
PILOT_PASSWORD_HASH=replace-with-caddy-bcrypt-hash
RAG_ENABLED=true
RAG_SOURCE_PATHS=rag_sources
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=180
RAG_EMBEDDING_DIMENSIONS=256
RAG_TOP_K=4
RAG_MAX_QUESTION_CHARS=500
